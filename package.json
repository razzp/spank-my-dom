{
    "name": "spank-my-dom",
    "type": "module",
    "version": "2.4.0",
    "author": "Robert Wells",
    "description": "A tiny, modular set of DOM utilities, written in TypeScript.",
    "keywords": [
        "html",
        "dom",
        "browser",
        "javascript",
        "typescript",
        "utilities",
        "helpers"
    ],
    "license": "MIT",
    "bugs": "https://github.com/razzp/spank-my-dom/issues",
    "homepage": "https://github.com/razzp/spank-my-dom#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/razzp/spank-my-dom.git"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsdown",
        "test": "vitest run --isolate=false",
        "docs": "typedoc",
        "biome": "biome check --write",
        "release": "bumpp && npm publish"
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.2",
        "@types/jsdom": "^27.0.0",
        "bossy-boots": "^1.1.1",
        "bumpp": "^12.3.0",
        "jest": "^30.2.0",
        "jest-environment-jsdom": "^30.2.0",
        "jsdom": "^27.1.0",
        "rimraf": "^6.1.0",
        "tsdown": "^0.23.0",
        "typedoc": "^0.28.20",
        "typedoc-plugin-markdown": "^4.13.1",
        "typescript": "^6.0.3",
        "vitest": "^5.0.3"
    }
}
